<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:studentspage="using:SchoolManagementFrontend.ViewModels.MainPages.StudentsPage"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SchoolManagementFrontend.StudentsPage">
  <Grid>
	  <Grid.ColumnDefinitions>
		  <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TreeView Grid.Column="0" 
                ItemsSource="{Binding Classes}">
		  <TreeView.DataTemplates>
			  <TreeDataTemplate DataType="studentspage:ClassGroupViewModel" ItemsSource="{Binding Students}">
				  <TextBlock Text="{Binding ClassName}"/>
              </TreeDataTemplate>
              <DataTemplate DataType="studentspage:StudentViewModel">
				  <TextBlock Text="{Binding StudentName}"/>
              </DataTemplate>
          </TreeView.DataTemplates>
      </TreeView>
  </Grid>
</UserControl>
